{
  "name": "nextjs_tailwind_shadcn_ts",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "predev": "prisma generate && DATABASE_URL=${DATABASE_URL:-file:${PWD}/db/custom.db} prisma db push",
    "prestart": "prisma generate && DATABASE_URL=${DATABASE_URL:-file:${PWD}/db/custom.db} prisma db push && npm --prefix mini-services/crawler-service run build",
    "prebuild": "npm --prefix mini-services/crawler-service run build",
    "dev": "next dev -p 3000",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "NODE_ENV=production node .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "db:push": "DATABASE_URL=${DATABASE_URL:-file:${PWD}/db/custom.db} prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "DATABASE_URL=${DATABASE_URL:-file:${PWD}/db/custom.db} prisma migrate dev",
    "db:reset": "DATABASE_URL=${DATABASE_URL:-file:${PWD}/db/custom.db} prisma migrate reset",
    "db:init": "mkdir -p db && DATABASE_URL=${DATABASE_URL:-file:${PWD}/db/custom.db} prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@tanstack/react-query": "^5.82.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "playwright": "^1.59.1",
    "prisma": "^6.11.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-syntax-highlighter": "^15.6.1",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.3.5",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "25.7.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
