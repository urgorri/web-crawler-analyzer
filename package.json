{
  "name": "web-crawler-analyzer",
  "version": "0.2.0",
  "description": "Modular web crawler, SEO metadata analyzer, and web intelligence orchestration shell built with Next.js and Playwright.",
  "author": "Gastón Urgorri <urgorrigaston@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/urgorri/web-crawler-analyzer.git"
  },
  "bugs": {
    "url": "https://github.com/urgorri/web-crawler-analyzer/issues"
  },
  "homepage": "https://github.com/urgorri/web-crawler-analyzer#readme",
  "keywords": [
    "web-crawler",
    "seo-analyzer",
    "security-headers",
    "tech-profiler",
    "playwright",
    "nextjs",
    "website-analysis",
    "boilerplate",
    "orchestration-shell"
  ],
  "private": true,
  "workspaces": [
    "mini-services/*"
  ],
  "scripts": {
    "prebuild": "npm --prefix mini-services/crawler-service run build",
    "dev": "next dev -p 3000",
    "build": "next build && node scripts/copy-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prestart": "npm --prefix mini-services/crawler-service run build"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.21",
    "@radix-ui/react-alert-dialog": "^1.1.24",
    "@radix-ui/react-collapsible": "^1.1.21",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.3.0",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-syntax-highlighter": "^16.1.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tldts": "^7.4.18",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
