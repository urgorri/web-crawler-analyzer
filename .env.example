# WebScope Environment Configuration Example
# Copy this file to .env.local or .env for local development

# Node environment (development | production | test)
NODE_ENV=development

# Web server port (default: 3000)
PORT=3000

# Security: Allow crawling private networks and localhost aliases (127.0.0.1, 10.x, 192.168.x, etc.)
# WARNING: Keep set to false in production to prevent Server-Side Request Forgery (SSRF).
ALLOW_PRIVATE_TARGETS=false

# Development: Fall back to executing crawler via `tsx` if compiled dist/crawl.js is absent
ALLOW_TS_CRAWLER_FALLBACK=false

# Optional: Custom location for Playwright browser binaries
# PLAYWRIGHT_BROWSERS_PATH=0

# Disable Next.js anonymous telemetry
NEXT_TELEMETRY_DISABLED=1
