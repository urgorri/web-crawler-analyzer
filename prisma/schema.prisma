generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Crawl {
  id          String   @id @default(cuid())
  name        String?
  status      String   @default("pending") // pending, running, completed, failed, partial
  urls        String   // JSON array of seed URLs
  config      String?  // JSON config used
  engine      String   @default("playwright")
  seedCount   Int      @default(0)
  pageCount   Int      @default(0)
  errorCount  Int      @default(0)
  warnings    String?  // JSON array of warnings
  errors      String?  // JSON array of non-sensitive errors
  startedAt   DateTime @default(now())
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pages Page[]

  @@index([status])
  @@index([createdAt])
}

model Page {
  id            String   @id @default(cuid())
  crawlId       String
  crawl         Crawl    @relation(fields: [crawlId], references: [id], onDelete: Cascade)
  url           String
  finalUrl      String?
  statusCode    Int?
  title         String?
  metaDescription String?
  canonical     String?
  robotsMeta    String?
  lang          String?
  dir           String?
  charset       String?
  visibleText   String?
  visibleTextRaw String?
  wordCount     Int      @default(0)
  charCount     Int      @default(0)
  headings      String?  // JSON: { h1: string[], h2: string[], h3: string[] }
  buttons       String?  // JSON array of button data
  links         String?  // JSON: { internal: [], external: [] }
  forms         String?  // JSON array of form data
  images        String?  // JSON array of image data
  scripts       String?  // JSON array of script URLs
  stylesheets   String?  // JSON array of stylesheet URLs
  resources     String?  // JSON array of resource data
  network       String?  // JSON array of network request data
  structuredData String? // JSON array of JSON-LD objects
  bodyClasses   String?  // JSON array of body class names
  techEvidence  String?  // JSON array of tech evidence strings
  htmlClasses   String?  // JSON array of html class names
  metaGenerator String?
  error         String?
  scrapedAt     DateTime @default(now())

  @@index([crawlId])
  @@index([url])
}
